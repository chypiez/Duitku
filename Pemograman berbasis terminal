const int JML_KATEGORI = 6;
extern const string KATEGORI[JML_KATEGORI];

// ---------- Tipe data ----------
struct Transaksi {
    int id;              // ID unik otomatis
    string tanggal;      // format YYYY-MM-DD
    string keterangan;   // deskripsi singkat
    string kategori;     // Makan, Transport, Kuliah, Hiburan, Kos, Lainnya
    long long nominal;   // dalam rupiah
    string tipe;         // "Pemasukan" / "Pengeluaran"
};
typedef Transaksi infotype;

typedef struct Node *address;   // address = pointer ke Node
struct Node {
    infotype info;
    address next;               // pointer ke node berikutnya
};

struct List {
    address first;              // head
    int nextId;                 // penghitung ID otomatis
};

struct Pengaturan {
    long long anggaran;         // anggaran bulanan
    long long batasHarian;      // 0 = tidak aktif
    long long batasBulanan;
    long long batasTahunan;
};

// ---------- Primitif SLL ----------
void createList(List &L);
bool isEmpty(List L);
address alokasi(infotype x);
void dealokasi(address &P);                 // mengembalikan memori node

void insertFirst(List &L, address P);
void insertLast(List &L, address P);
void insertAfter(address Prec, address P);

void deleteFirst(List &L, address &P);
void deleteLast(List &L, address &P);
void deleteAfter(address Prec, address &P);

void clearList(List &L);                    // dealokasi seluruh node
int countNodes(List L);

// ---------- Pencarian & agregasi ----------
address findByID(List L, int id);                       // Linear Search
int searchKeyword(List L, const string &kw);            // Linear Search (cetak hasil)
address findMaxPengeluaran(List L, const string &prefix = ""); // FindMax
long long totalPengeluaran(List L, const string &prefix = "");
long long totalPemasukan(List L, const string &prefix = "");

// ---------- Tampilan ----------
string formatRupiah(long long n);
void printHeader();
void printRow(const infotype &t);
void printAll(List L);
void printRange(List L, const string &awal, const string &akhir);
void printRingkasanKategori(List L, const string &prefix);

// ---------- Utilitas ----------
string toStr(long long n);                  // angka -> string
bool parseLL(const string &s, long long &out); // string -> angka (false jika tidak valid)
bool isValidDate(const string &s);          // YYYY-MM-DD
string todayString();

// ---------- File ----------
